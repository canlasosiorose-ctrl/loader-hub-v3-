CloseButton.MouseButton1Click:Connect(function()
playOof()
task.wait(0.15)
ScreenGui:Destroy()
end)
local isMinimized = false
MinimizeButton.MouseButton1Click:Connect(function()
playOof()
isMinimized = not isMinimized
if isMinimized then
LoadersPage.Visible = false
MainFrame:TweenSize(UDim2.new(0, 280, 0, 42), "Out", "Quad", 0.2, true)
MinimizeButton.Text = "+"
else
MainFrame:TweenSize(UDim2.new(0, 280, 0, 260), "Out", "Quad", 0.2, true, function()
LoadersPage.Visible = true
end)
MinimizeButton.Text = "-"
end
end)
RunButton.MouseButton1Click:Connect(function()
playOof()
local targetScript = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/tienkhanh1/spicy/main/Chilli.lua"))()'
RunText.Text = "Processing..."
if setclipboard then setclipboard(targetScript) end
pcall(function()
loadstring(game:HttpGet("https://raw.githubusercontent.com/tienkhanh1/spicy/main/Chilli.lua"))()
end)
task.wait(0.4)
RunText.Text = "Run Chilli Hub"
end)
local targetId = game.PlaceId
local targetGame = game.GameId
if targetId ~= 142823291 and targetGame ~= 66654135 then
OnyxButton.Active = false
OnyxButton.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
OnyxText.Text = "OnyxHub (Not MM2!)"
OnyxText.TextColor3 = Color3.fromRGB(80, 80, 80)
WaguriButton.Active = false
WaguriButton.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
WaguriText.Text = "Waguri Lite (Not MM2!)"
WaguriText.TextColor3 = Color3.fromRGB(80, 80, 80)
HoneyButton.Active = false
HoneyButton.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
HoneyText.Text = "Honey Lua (Not MM2!)"
HoneyText.TextColor3 = Color3.fromRGB(80, 80, 80)
else
OnyxButton.MouseButton1Click:Connect(function()
playOof()
local onyxScript = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/zyntrix20/OnyxHub/refs/heads/main/Loader"))()'
OnyxText.Text = "Processing..."
if setclipboard then setclipboard(onyxScript) end
pcall(function()
loadstring(game:HttpGet("https://raw.githubusercontent.com/zyntrix20/OnyxHub/refs/heads/main/Loader"))()
end)
task.wait(0.4)
OnyxText.Text = "Run OnyxHub"
end)
WaguriButton.MouseButton1Click:Connect(function()
playOof()
local waguriScript = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/Waguriiiii/Murder-mystery-2/refs/heads/main/Waguri-lite"))()'
WaguriText.Text = "Processing..."
if setclipboard then setclipboard(waguriScript) end
pcall(function()
loadstring(game:HttpGet("https://raw.githubusercontent.com/Waguriiiii/Murder-mystery-2/refs/heads/main/Waguri-lite"))()
end)
task.wait(0.4)
WaguriText.Text = "Run Waguri Lite"
end)
HoneyButton.MouseButton1Click:Connect(function()
playOof()
local honeyScript = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/mervsbsvsb/MurderMystery2Keyless/refs/heads/main/HoneyLua.lua"))()'
HoneyText.Text = "Processing..."
if setclipboard then setclipboard(honeyScript) end
pcall(function()
loadstring(game:HttpGet("https://raw.githubusercontent.com/mervsbsvsb/MurderMystery2Keyless/refs/heads/main/HoneyLua.lua"))()
end)
task.wait(0.4)
HoneyText.Text = "Run Honey Lua"
end)
end
if targetId ~= 17134375084 and targetGame ~= 5936306069 then
RivalsButton.Active = false
RivalsButton.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
RivalsText.Text = "Rivals Aimbot (Not Rivals!)"
RivalsText.TextColor3 = Color3.fromRGB(80, 80, 80)
else
RivalsButton.MouseButton1Click:Connect(function()
playOof()
local rivalsScript = 'loadstring(game:HttpGet("https://rawscripts.net/raw/RIVALS-Aimbot-no-banned-yes-sure-102092"))()'
RivalsText.Text = "Processing..."
if setclipboard then setclipboard(rivalsScript) end
pcall(function()
loadstring(game:HttpGet("https://rawscripts.net/raw/RIVALS-Aimbot-no-banned-yes-sure-102092"))()
end)
task.wait(0.4)
RivalsText.Text = "Run Aimbot (Rivals)"
end)
